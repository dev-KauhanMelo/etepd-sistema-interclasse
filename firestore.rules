rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /classes/{doc}       { allow read: if true; allow write: if isAdmin(); }
    match /modalities/{doc}    { allow read: if true; allow write: if isAdmin(); }
    // Jogos: leitura pública, escrita só de admin — com UMA exceção: o botão
    // de torcida. Qualquer pessoa pode dar um update que mexa APENAS nos
    // contadores de torcida, somando no máximo +1 por vez.
    match /matches/{doc} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cheerCountA', 'cheerCountB']) &&
        request.resource.data.get('cheerCountA', 0) >= resource.data.get('cheerCountA', 0) &&
        request.resource.data.get('cheerCountA', 0) <= resource.data.get('cheerCountA', 0) + 1 &&
        request.resource.data.get('cheerCountB', 0) >= resource.data.get('cheerCountB', 0) &&
        request.resource.data.get('cheerCountB', 0) <= resource.data.get('cheerCountB', 0) + 1;
    }
    match /standings/{doc}     { allow read: if true; allow write: if isAdmin(); }
    // Pódio de cada modalidade e punições: alimentam o ranking geral.
    match /podiums/{doc}       { allow read: if true; allow write: if isAdmin(); }
    match /penalties/{doc}     { allow read: if true; allow write: if isAdmin(); }
    // Performance, Torcida e Camisas (§9): somam ao placar geral.
    match /awards/{doc}        { allow read: if true; allow write: if isAdmin(); }
    match /brackets/{doc}      { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{doc}      { allow read: if true; allow write: if isAdmin(); }

    // Bolão: qualquer um lê e cria palpite, mas só enquanto o jogo está
    // agendado (a bola rolou = palpites fechados). Ninguém edita depois —
    // o id do doc é matchId_userId, então só existe 1 palpite por pessoa/jogo.
    match /predictions/{doc} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(['matchId', 'userId', 'userName', 'userClass', 'scoreA', 'scoreB', 'createdAt']) &&
        request.resource.data.userName is string &&
        request.resource.data.userName.size() >= 2 &&
        request.resource.data.userName.size() <= 40 &&
        request.resource.data.userClass is string &&
        request.resource.data.userClass.size() <= 40 &&
        request.resource.data.scoreA is int &&
        request.resource.data.scoreA >= 0 && request.resource.data.scoreA <= 99 &&
        request.resource.data.scoreB is int &&
        request.resource.data.scoreB >= 0 && request.resource.data.scoreB <= 99 &&
        doc == request.resource.data.matchId + '_' + request.resource.data.userId &&
        get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status == 'scheduled';
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
